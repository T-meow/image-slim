{
  "name": "image-slim",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "ipc:generate": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example export_bindings -- src/lib/generated/ipc.ts",
    "ipc:check": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example export_bindings -- src/lib/generated/ipc.ts --check",
    "version:check": "node scripts/check-version.mjs",
    "config:check": "node scripts/check-project-config.mjs",
    "release:check": "node scripts/stage-release.mjs --check",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run licenses && tauri build && node scripts/stage-release.mjs",
    "tauri:build:no-bundle": "npm run licenses && tauri build --no-bundle && node scripts/stage-release.mjs --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-svelte": "^1.0.0",
    "svelte": "^5.56.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.2",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
